# Keep this value server-side. Never prefix it with VITE_ or commit a real key.
OPENAI_API_KEY=your_key_here
OPENAI_HINT_MODEL=gpt-5-mini
HINT_SERVER_PORT=8787
APP_ORIGIN=http://localhost:5173

# Optional frontend override when the hint service is deployed elsewhere.
VITE_HINT_API_URL=http://localhost:8787/api/hint
VITE_QUIZ_API_URL=http://localhost:8787/api/quiz

# Public-MVP release controls. These values are browser-visible and must not contain secrets.
VITE_PUBLIC_BETA_ENABLED=false
# Optional public issue form or discussion page. When absent, feedback is copied only.
VITE_PUBLIC_FEEDBACK_URL=
